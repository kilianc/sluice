{
  "version": 1,
  "op": "compile",
  "schema": "documents",
  "dialect": "postgres",
  "description": "Exact SQL and arguments. Every binary node is parenthesized unconditionally so output is determinable without precedence reasoning. Placeholders are $1..$n in argument order.",
  "cases": [
    {
      "name": "predicates emit without enclosing parentheses",
      "input": "state = \"shared\"",
      "sql": "LOWER(doc.state) = $1",
      "args": ["shared"],
      "fields": ["state"]
    },
    {
      "name": "case folding lowercases the argument, not the SQL text",
      "input": "state = \"SHARED\"",
      "sql": "LOWER(doc.state) = $1",
      "args": ["shared"],
      "fields": ["state"]
    },
    {
      "name": "inequality",
      "input": "state != \"shared\"",
      "sql": "LOWER(doc.state) != $1",
      "args": ["shared"],
      "fields": ["state"]
    },
    {
      "name": "contains, with an explicit ESCAPE clause",
      "input": "name ~ \"Cell\"",
      "sql": "LOWER(doc.name) LIKE $1 ESCAPE '\\'",
      "args": ["%cell%"],
      "fields": ["name"]
    },
    {
      "name": "does not contain",
      "input": "name !~ \"cell\"",
      "sql": "LOWER(doc.name) NOT LIKE $1 ESCAPE '\\'",
      "args": ["%cell%"],
      "fields": ["name"]
    },
    {
      "name": "a case-sensitive field folds neither the column nor the argument",
      "schema": {
        "name": "tags",
        "options": { "caseInsensitive": false },
        "fields": [{ "name": "tag", "type": "string", "column": "t.name" }]
      },
      "input": "tag ~ \"Cell\"",
      "sql": "t.name LIKE $1 ESCAPE '\\'",
      "args": ["%Cell%"],
      "fields": ["tag"]
    },
    {
      "name": "LIKE metacharacters are escaped in the argument — the origin bug",
      "input": "name ~ \"100%_x\"",
      "sql": "LOWER(doc.name) LIKE $1 ESCAPE '\\'",
      "args": ["%100\\%\\_x%"],
      "fields": ["name"]
    },
    {
      "name": "a literal backslash is escaped before the metacharacters",
      "input": "name ~ \"a\\\\b\"",
      "sql": "LOWER(doc.name) LIKE $1 ESCAPE '\\'",
      "args": ["%a\\\\b%"],
      "fields": ["name"]
    },
    {
      "name": "boolean",
      "input": "active = true",
      "sql": "doc.active = $1",
      "args": [true],
      "fields": ["active"]
    },
    {
      "name": "negation",
      "input": "NOT active = true",
      "sql": "(NOT doc.active = $1)",
      "args": [true],
      "fields": ["active"]
    },
    {
      "name": "number",
      "input": "words >= 32",
      "sql": "doc.words >= $1",
      "args": [32],
      "fields": ["words"]
    },
    {
      "name": "uuid is cast in SQL and lowercased in the argument",
      "input": "id = \"3F2504E0-4F89-11D3-9A0C-0305E82C3301\"",
      "sql": "doc.id = $1::uuid",
      "args": ["3f2504e0-4f89-11d3-9a0c-0305e82c3301"],
      "fields": ["id"]
    },
    {
      "name": "duration coerces to integer seconds; no interval text reaches SQL",
      "input": "edited > \"2 days\"",
      "sql": "EXTRACT(EPOCH FROM (NOW() - rev.created_at)) > $1",
      "args": [172800],
      "fields": ["edited"]
    },
    {
      "name": "compound duration",
      "input": "edited > \"1w 2d\"",
      "sql": "EXTRACT(EPOCH FROM (NOW() - rev.created_at)) > $1",
      "args": [777600],
      "fields": ["edited"]
    },
    {
      "name": "conjunction, arguments numbered in traversal order",
      "input": "state = \"shared\" AND name ~ \"Cell\"",
      "sql": "(LOWER(doc.state) = $1 AND LOWER(doc.name) LIKE $2 ESCAPE '\\')",
      "args": ["shared", "%cell%"],
      "fields": ["state", "name"]
    },
    {
      "name": "precedence is materialized in the output",
      "input": "state = \"shared\" OR active = true AND words > 8",
      "sql": "(LOWER(doc.state) = $1 OR (doc.active = $2 AND doc.words > $3))",
      "args": ["shared", true, 8],
      "fields": ["state", "active", "words"]
    },
    {
      "name": "parentheses",
      "input": "(state = \"shared\" OR active = true) AND words > 8",
      "sql": "((LOWER(doc.state) = $1 OR doc.active = $2) AND doc.words > $3)",
      "args": ["shared", true, 8],
      "fields": ["state", "active", "words"]
    },
    {
      "name": "dynamic enum values are accepted when supplied",
      "input": "team = \"DESIGN-A\"",
      "dynamic": { "team": ["DESIGN-A", "DESI-R02"] },
      "sql": "LOWER(grp.name) = $1",
      "args": ["design-a"],
      "fields": ["team"]
    },
    {
      "name": "a field referenced twice appears once in fields",
      "input": "name ~ \"a\" OR name ~ \"b\"",
      "sql": "(LOWER(doc.name) LIKE $1 ESCAPE '\\' OR LOWER(doc.name) LIKE $2 ESCAPE '\\')",
      "args": ["%a%", "%b%"],
      "fields": ["name"]
    },
    {
      "name": "empty input compiles to empty — never 1=1",
      "input": "",
      "sql": "",
      "args": [],
      "fields": []
    }
  ]
}
