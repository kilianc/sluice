{
  "version": 1,
  "op": "compile",
  "schema": "machines",
  "dialect": "postgres",
  "description": "Exact SQL and arguments. Every binary node is parenthesized unconditionally so output is determinable without precedence reasoning. Placeholders are $1..$n in argument order.",
  "cases": [
    {
      "name": "predicates emit without enclosing parentheses",
      "input": "phase = \"in-use\"",
      "sql": "LOWER(inv.phase) = $1",
      "args": ["in-use"],
      "fields": ["phase"]
    },
    {
      "name": "case folding lowercases the argument, not the SQL text",
      "input": "phase = \"IN-USE\"",
      "sql": "LOWER(inv.phase) = $1",
      "args": ["in-use"],
      "fields": ["phase"]
    },
    {
      "name": "inequality",
      "input": "phase != \"in-use\"",
      "sql": "LOWER(inv.phase) != $1",
      "args": ["in-use"],
      "fields": ["phase"]
    },
    {
      "name": "contains, with an explicit ESCAPE clause",
      "input": "name ~ \"Cell\"",
      "sql": "LOWER(inv.name) LIKE $1 ESCAPE '\\'",
      "args": ["%cell%"],
      "fields": ["name"]
    },
    {
      "name": "does not contain",
      "input": "name !~ \"cell\"",
      "sql": "LOWER(inv.name) NOT LIKE $1 ESCAPE '\\'",
      "args": ["%cell%"],
      "fields": ["name"]
    },
    {
      "name": "a case-sensitive field folds neither the column nor the argument",
      "schema": {
        "name": "tags",
        "options": { "caseInsensitive": false },
        "fields": [{ "name": "tag", "type": "string", "column": "t.name" }]
      },
      "input": "tag ~ \"Cell\"",
      "sql": "t.name LIKE $1 ESCAPE '\\'",
      "args": ["%Cell%"],
      "fields": ["tag"]
    },
    {
      "name": "LIKE metacharacters are escaped in the argument — the origin bug",
      "input": "name ~ \"100%_x\"",
      "sql": "LOWER(inv.name) LIKE $1 ESCAPE '\\'",
      "args": ["%100\\%\\_x%"],
      "fields": ["name"]
    },
    {
      "name": "a literal backslash is escaped before the metacharacters",
      "input": "name ~ \"a\\\\b\"",
      "sql": "LOWER(inv.name) LIKE $1 ESCAPE '\\'",
      "args": ["%a\\\\b%"],
      "fields": ["name"]
    },
    {
      "name": "boolean",
      "input": "online = true",
      "sql": "inv.online = $1",
      "args": [true],
      "fields": ["online"]
    },
    {
      "name": "negation",
      "input": "NOT online = true",
      "sql": "(NOT inv.online = $1)",
      "args": [true],
      "fields": ["online"]
    },
    {
      "name": "number",
      "input": "cores >= 32",
      "sql": "inv.cores >= $1",
      "args": [32],
      "fields": ["cores"]
    },
    {
      "name": "uuid is cast in SQL and lowercased in the argument",
      "input": "id = \"3F2504E0-4F89-11D3-9A0C-0305E82C3301\"",
      "sql": "inv.id = $1::uuid",
      "args": ["3f2504e0-4f89-11d3-9a0c-0305e82c3301"],
      "fields": ["id"]
    },
    {
      "name": "duration coerces to integer seconds; no interval text reaches SQL",
      "input": "os_age > \"2 days\"",
      "sql": "EXTRACT(EPOCH FROM (NOW() - img.created_at)) > $1",
      "args": [172800],
      "fields": ["os_age"]
    },
    {
      "name": "compound duration",
      "input": "os_age > \"1w 2d\"",
      "sql": "EXTRACT(EPOCH FROM (NOW() - img.created_at)) > $1",
      "args": [777600],
      "fields": ["os_age"]
    },
    {
      "name": "conjunction, arguments numbered in traversal order",
      "input": "phase = \"in-use\" AND name ~ \"Cell\"",
      "sql": "(LOWER(inv.phase) = $1 AND LOWER(inv.name) LIKE $2 ESCAPE '\\')",
      "args": ["in-use", "%cell%"],
      "fields": ["phase", "name"]
    },
    {
      "name": "precedence is materialized in the output",
      "input": "phase = \"in-use\" OR online = true AND cores > 8",
      "sql": "(LOWER(inv.phase) = $1 OR (inv.online = $2 AND inv.cores > $3))",
      "args": ["in-use", true, 8],
      "fields": ["phase", "online", "cores"]
    },
    {
      "name": "parentheses",
      "input": "(phase = \"in-use\" OR online = true) AND cores > 8",
      "sql": "((LOWER(inv.phase) = $1 OR inv.online = $2) AND inv.cores > $3)",
      "args": ["in-use", true, 8],
      "fields": ["phase", "online", "cores"]
    },
    {
      "name": "dynamic enum values are accepted when supplied",
      "input": "rack = \"ASH1-R01\"",
      "dynamic": { "rack": ["ASH1-R01", "ASH1-R02"] },
      "sql": "LOWER(loc.name) = $1",
      "args": ["ash1-r01"],
      "fields": ["rack"]
    },
    {
      "name": "a field referenced twice appears once in fields",
      "input": "name ~ \"a\" OR name ~ \"b\"",
      "sql": "(LOWER(inv.name) LIKE $1 ESCAPE '\\' OR LOWER(inv.name) LIKE $2 ESCAPE '\\')",
      "args": ["%a%", "%b%"],
      "fields": ["name"]
    },
    {
      "name": "empty input compiles to empty — never 1=1",
      "input": "",
      "sql": "",
      "args": [],
      "fields": []
    }
  ]
}
