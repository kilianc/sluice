{
  "version": 1,
  "op": "parse",
  "schema": "documents",
  "description": "AST structure, precedence and associativity. Spans on non-predicate nodes are optional and are not asserted here.",
  "cases": [
    {
      "name": "simple predicate",
      "input": "state = \"shared\"",
      "ast": {
        "kind": "predicate",
        "field": "state",
        "op": "=",
        "value": { "type": "string", "value": "shared" },
        "span": [0, 16]
      }
    },
    {
      "name": "field names resolve case-insensitively and normalize to lowercase",
      "input": "STATE = \"shared\"",
      "ast": {
        "kind": "predicate",
        "field": "state",
        "op": "=",
        "value": { "type": "string", "value": "shared" },
        "span": [0, 16]
      }
    },
    {
      "name": "AND binds tighter than OR",
      "input": "state = \"shared\" OR active = true AND words > 8",
      "ast": {
        "kind": "binary",
        "op": "or",
        "left": {
          "kind": "predicate",
          "field": "state",
          "op": "=",
          "value": { "type": "string", "value": "shared" },
          "span": [0, 16]
        },
        "right": {
          "kind": "binary",
          "op": "and",
          "left": {
            "kind": "predicate",
            "field": "active",
            "op": "=",
            "value": { "type": "boolean", "value": true },
            "span": [20, 33]
          },
          "right": {
            "kind": "predicate",
            "field": "words",
            "op": ">",
            "value": { "type": "number", "value": 8 },
            "span": [38, 47]
          }
        }
      }
    },
    {
      "name": "AND is left-associative",
      "input": "state = \"shared\" AND active = true AND words > 8",
      "ast": {
        "kind": "binary",
        "op": "and",
        "left": {
          "kind": "binary",
          "op": "and",
          "left": {
            "kind": "predicate",
            "field": "state",
            "op": "=",
            "value": { "type": "string", "value": "shared" },
            "span": [0, 16]
          },
          "right": {
            "kind": "predicate",
            "field": "active",
            "op": "=",
            "value": { "type": "boolean", "value": true },
            "span": [21, 34]
          }
        },
        "right": {
          "kind": "predicate",
          "field": "words",
          "op": ">",
          "value": { "type": "number", "value": 8 },
          "span": [39, 48]
        }
      }
    },
    {
      "name": "NOT binds tighter than AND",
      "input": "NOT active = true",
      "ast": {
        "kind": "not",
        "expr": {
          "kind": "predicate",
          "field": "active",
          "op": "=",
          "value": { "type": "boolean", "value": true },
          "span": [4, 17]
        }
      }
    },
    {
      "name": "parentheses override precedence",
      "input": "(state = \"shared\" OR active = true) AND words > 8",
      "ast": {
        "kind": "binary",
        "op": "and",
        "left": {
          "kind": "binary",
          "op": "or",
          "left": {
            "kind": "predicate",
            "field": "state",
            "op": "=",
            "value": { "type": "string", "value": "shared" },
            "span": [1, 17]
          },
          "right": {
            "kind": "predicate",
            "field": "active",
            "op": "=",
            "value": { "type": "boolean", "value": true },
            "span": [21, 34]
          }
        },
        "right": {
          "kind": "predicate",
          "field": "words",
          "op": ">",
          "value": { "type": "number", "value": 8 },
          "span": [40, 49]
        }
      }
    },
    {
      "name": "duration literals stay strings in the AST and coerce at emit time",
      "input": "edited > \"2 days\"",
      "ast": {
        "kind": "predicate",
        "field": "edited",
        "op": ">",
        "value": { "type": "string", "value": "2 days" },
        "span": [0, 17]
      }
    },
    {
      "name": "empty input parses to no expression",
      "input": "",
      "ast": null
    },
    {
      "name": "whitespace-only input parses to no expression",
      "input": "   ",
      "ast": null
    }
  ]
}
